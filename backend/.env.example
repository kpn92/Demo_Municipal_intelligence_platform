# Smart City Operations Platform — Backend Environment Variables
# Copy to .env and fill in your values

# ─────────────────────────────────────────────
# Application
# ─────────────────────────────────────────────
APP_NAME=Smart City Operations Platform
APP_VERSION=0.4.0
APP_ENV=development   # development | production

# ─────────────────────────────────────────────
# Database  (PostgreSQL + PostGIS)
# ─────────────────────────────────────────────
# Local dev (Docker Compose):
DATABASE_URL=postgresql+psycopg://postgres:yourpassword@localhost:5432/smart_city_db
# Supabase (production):
# DATABASE_URL=postgresql+psycopg://postgres:[password]@db.[project-ref].supabase.co:5432/postgres

# ─────────────────────────────────────────────
# Frontend (used for QR codes in PDF exports)
# ─────────────────────────────────────────────
FRONTEND_BASE_URL=http://localhost:5173

# ─────────────────────────────────────────────
# Optional
# ─────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=
